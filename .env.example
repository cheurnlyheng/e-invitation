# Copy to .env.local for local development, and set the same names in Vercel
# (Project -> Settings -> Environment Variables) for the live site.

# Password for /admin (at least 6 characters). Without it the dashboard stays locked.
ADMIN_PASSWORD=

# Optional: a separate secret used to sign the admin session cookie.
# Defaults to ADMIN_PASSWORD; set it if you want to sign everyone out by changing it.
ADMIN_SECRET=

# Postgres connection string (Neon). On Vercel the Neon integration adds this for you.
# Leave empty locally and a git-ignored file in .data/ is used instead.
DATABASE_URL=
